#!/usr/bin/env sh
# ----------------------------------------------------------------------------
# Stage 6 — Secret-scan pre-push gate.
# Blocks `git push` if a secret is detected. Scanner preference:
#   1) betterleaks binary on PATH   2) gitleaks binary on PATH
#   3) betterleaks via Docker image (works when no binary is installed)
# All read .gitleaks.toml. Install: see knowledge/templates/secret-scan/README.md
# Bypass (you own the risk): git push --no-verify
# ----------------------------------------------------------------------------
set -eu

# ----------------------------------------------------------------------------
# Guard 1 of 2 — TRACKED PATHS. Runs before the scanner, because a whole class of
# secret is invisible to content scanning.
#
# Verified on a real Ansible project (2026-08-01): `.vault_pass` holds the key that
# decrypts every vault in the repo, and gitleaks scans it and reports "no leaks
# found". It is right to: the file is a bare high-entropy string with no keyword
# context, matching no rule. The same is true of a raw `.mcp.json` token and of a
# `backend-<env>.hcl` holding an account id. For these the protection is .gitignore
# — and .gitignore is exactly one `git add -f` away from being bypassed, with the
# content scanner offering no second opinion.
#
# So: match on PATH, deterministically, and fail closed. The list is deliberately
# short — every entry is a file that is a credential, not one that might contain one.
#
# The `vault*` glob is deliberate: Ansible loads `vault`, `vault.yml` and `vault.yaml`
# identically, and a rule naming only one spelling protects one file rather than the pattern.
# An unencrypted `vault.yml` holding a sha512crypt hash matches no gitleaks rule either, so
# both layers would miss it together. Verified with `git check-ignore -v` on a real project.
SECRET_PATHS='
.vault_pass
.vault_pass.txt
.mcp.json
.env
credentials.json
id_rsa
id_ed25519
id_ecdsa
'
tracked_secret_paths() {
  git ls-files -z | tr '\0' '\n' | while IFS= read -r f; do
    # The committed TWINS are the documentation of the shape, and the convention this whole
    # repo runs on is "commit the .example, gitignore the filled file". A guard that blocks
    # `vault.example` or `inventory.ini.example` blocks a file that is SUPPOSED to be tracked
    # -- and the first thing anyone does with a guard that cries wolf is switch it off.
    case "$f" in
      *.example|*.example.*|*.sample|*.template|*.dist) continue ;;
    esac
    b=$(basename "$f")
    for pat in $SECRET_PATHS; do [ "$b" = "$pat" ] && { echo "$f"; break; }; done
    case "$f" in
      */.vault_pass*|.vault_pass*)            echo "$f" ;;
      */group_vars/*/vault*|group_vars/*/vault*)  echo "$f" ;;
      */host_vars/*/vault*|host_vars/*/vault*)    echo "$f" ;;
      */backend-*.hcl|backend-*.hcl)          echo "$f" ;;
      *.pem|*.p12|*.pfx)                      echo "$f" ;;
      *.tfstate|*.tfstate.backup)             echo "$f" ;;
    esac
  done | sort -u
}

OFFENDERS=$(tracked_secret_paths)
if [ -n "$OFFENDERS" ]; then
  echo "❌ secret-scan: these paths are TRACKED BY GIT and must not be — PUSH BLOCKED."
  echo "$OFFENDERS" | sed 's/^/     /'
  echo
  echo "   A content scanner will not save you here: a vault password or an API token is"
  echo "   a bare high-entropy string that matches no rule, so it scans clean."
  echo "   1) git rm --cached <path>   2) confirm it is in .gitignore   3) ROTATE the secret"
  echo "      (it is in your local history already, and history is what gets pushed)"
  echo "   Deliberate exception? Remove the pattern from SECRET_PATHS in .githooks/pre-push"
  echo "   and say why in the commit message."
  exit 1
fi

# ----------------------------------------------------------------------------
# Guard 2 of 2 — CONTENT.
CONFIG_ARG=""
[ -f .gitleaks.toml ] && CONFIG_ARG="--config .gitleaks.toml"
BL_IMG="ghcr.io/betterleaks/betterleaks:latest"

# HISTORY vs WORKING TREE. The git-mode scanners read COMMITTED HISTORY, which is the
# right target for a push — except in the one case where it silently is not:
#
#   $ ./.githooks/pre-push          # brand-new repo, nothing committed yet
#   INF scanned ~0 bytes (0) in 233ms
#   INF no leaks found
#   ✅ secret-scan: no secrets found — push allowed.
#
# Observed for real (2026-08-01). Zero bytes examined, and the gate reports a pass. The
# operator sees a green tick and reasonably concludes their tree was checked. Detect the
# no-commit case and scan the DIRECTORY instead, saying which one ran — the two answer
# different questions and must never be confused for each other.
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  SCAN_TARGET="committed history"
else
  SCAN_TARGET="working tree (no commits yet — history would scan 0 bytes)"
fi

# Each scanner uses its native invocation (betterleaks -> `git .`, gitleaks -> `detect`).
# --redact hides secret values. A shell function wraps the call so the multi-word Docker
# command works under POSIX sh.
if command -v betterleaks >/dev/null 2>&1; then
  SCANNER="betterleaks (binary)"
  if [ "$SCAN_TARGET" = "committed history" ]; then
    run_scan() { betterleaks git . --redact ${CONFIG_ARG}; }
  else
    run_scan() { betterleaks dir . --redact ${CONFIG_ARG}; }
  fi
elif command -v gitleaks >/dev/null 2>&1; then
  SCANNER="gitleaks (binary)"
  if [ "$SCAN_TARGET" = "committed history" ]; then
    run_scan() { gitleaks detect --no-banner --redact ${CONFIG_ARG}; }
  else
    run_scan() { gitleaks dir . --no-banner --redact ${CONFIG_ARG}; }
  fi
elif command -v docker >/dev/null 2>&1 && docker image inspect "$BL_IMG" >/dev/null 2>&1; then
  SCANNER="betterleaks (docker)"
  # -u matches host ownership so git inside the container doesn't reject the mounted repo
  # ("dubious ownership"); the repo is mounted at /repo and .gitleaks.toml resolves there.
  if [ "$SCAN_TARGET" = "committed history" ]; then
    run_scan() { docker run --rm -u "$(id -u):$(id -g)" -v "$PWD:/repo" -w /repo "$BL_IMG" git . --redact ${CONFIG_ARG}; }
  else
    run_scan() { docker run --rm -u "$(id -u):$(id -g)" -v "$PWD:/repo" -w /repo "$BL_IMG" dir . --redact ${CONFIG_ARG}; }
  fi
else
  echo "❌ secret-scan: no scanner found (no betterleaks/gitleaks binary, no Docker image)."
  echo "   Install a binary, OR pull the image:  docker pull $BL_IMG"
  echo "   Bypass (not recommended): git push --no-verify"
  exit 1
fi

echo "🔎 secret-scan: scanning ${SCAN_TARGET} with ${SCANNER} before push…"
if run_scan; then
  echo "✅ secret-scan: no secrets found — push allowed."
  exit 0
else
  echo "❌ secret-scan: potential secret(s) detected — PUSH BLOCKED."
  echo "   1) Remove the secret from the code/history."
  echo "   2) If it was a real credential, ROTATE it immediately."
  echo "   3) False positive? Add its fingerprint to .gitleaksignore."
  exit 1
fi
