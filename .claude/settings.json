{
  "permissions": {
    "allow": [
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Bash(terraform output*)",
      "Bash(terraform graph*)",

      "Bash(aws * describe*)",
      "Bash(aws * list*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws iam get*)",
      "Bash(aws s3 ls*)",
      "Bash(aws s3api get-bucket*)",
      "Bash(aws apigateway get*)",
      "Bash(aws apigatewayv2 get*)",
      "Bash(aws lambda get*)",
      "Bash(aws cloudtrail get*)",
      "Bash(aws opensearchserverless get*)",
      "Bash(aws opensearchserverless batch-get*)",
      "Bash(aws accessanalyzer get*)",
      "Bash(aws accessanalyzer validate-policy*)",
      "Bash(aws ecr get-repository-policy*)",
      "Bash(aws ecr get-lifecycle-policy*)",
      "Bash(aws kms get-key-policy*)",
      "Bash(aws kms get-key-rotation-status*)",
      "Bash(aws cognito-idp get-user-pool*)",
      "Bash(aws cloudwatch get-metric*)",
      "Bash(aws cloudwatch get-dashboard*)",
      "Bash(aws logs get*)",
      "Bash(aws logs filter-log-events*)",

      "Bash(docker build*)",
      "Bash(docker images*)",
      "Bash(docker ps*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl top*)",
      "Bash(helm template*)",
      "Bash(helm lint*)",
      "Bash(helm list*)",
      "Bash(tflint*)",
      "Bash(checkov*)",
      "Bash(trivy*)",
      "Bash(hadolint*)",
      "Bash(terraform-docs*)"
    ],
    "deny": [
      "Bash(terraform destroy *)",
      "Bash(terraform apply -auto-approve *)",
      "Bash(aws iam delete* *)",
      "Bash(aws iam remove* *)",
      "Bash(aws ec2 terminate-instances *)",
      "Bash(aws ec2 delete* *)",
      "Bash(aws ec2 revoke* *)",
      "Bash(aws rds delete* *)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3api delete-bucket *)",
      "Bash(aws dynamodb delete-table *)",
      "Bash(aws lambda delete-function *)",
      "Bash(aws cognito-idp delete-user-pool *)",
      "Bash(aws opensearchserverless delete-collection *)",
      "Bash(aws cloudtrail delete-trail *)",
      "Bash(aws kms schedule-key-deletion *)",
      "Bash(aws kms disable-key *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=\"$CLAUDE_FILE\"; if [[ \"$file\" == *.tf ]]; then terraform fmt \"$file\" 2>/dev/null; fi"
          }
        ]
      }
    ]
  }
}
