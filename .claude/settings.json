{
  "permissions": {
    "allow": [
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Bash(terraform output*)",
      "Bash(terraform graph*)",
      "Bash(aws * describe*)",
      "Bash(aws * list*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws iam get*)",
      "Bash(aws s3 ls*)",
      "Bash(aws s3api get-bucket*)",
      "Bash(aws apigateway get*)",
      "Bash(aws apigatewayv2 get*)",
      "Bash(aws lambda get*)",
      "Bash(aws cloudtrail get*)",
      "Bash(aws opensearchserverless get*)",
      "Bash(aws opensearchserverless batch-get*)",
      "Bash(aws accessanalyzer get*)",
      "Bash(aws accessanalyzer validate-policy*)",
      "Bash(aws ecr get-repository-policy*)",
      "Bash(aws ecr get-lifecycle-policy*)",
      "Bash(aws kms get-key-policy*)",
      "Bash(aws kms get-key-rotation-status*)",
      "Bash(aws cognito-idp get-user-pool*)",
      "Bash(aws cloudwatch get-metric*)",
      "Bash(aws cloudwatch get-dashboard*)",
      "Bash(aws logs get*)",
      "Bash(aws logs filter-log-events*)",
      "Bash(ansible-doc*)",
      "Bash(ansible-config dump*)",
      "Bash(ansible-config view*)",
      "Bash(ansible-galaxy collection list*)",
      "Bash(ansible-galaxy role list*)",
      "Bash(ansible-lint --profile production --nocolor .)",
      "Bash(ansible-lint --profile production --nocolor ansible/)",
      "Bash(ansible-lint --profile production --nocolor)",
      "Bash(ansible-lint --profile production)",
      "Bash(ansible-lint --profile production .)",
      "Bash(ansible-lint --profile production ansible/)",
      "Bash(ansible-lint --nocolor -q *)",
      "Bash(ansible-lint --version*)",
      "Bash(yamllint*)",
      "Bash(molecule syntax*)",
      "Bash(molecule drivers*)",
      "Bash(molecule --version*)",
      "Bash(ansible-vault encrypt*)",
      "Bash(ansible-vault encrypt_string*)",
      "Bash(docker build*)",
      "Bash(docker images*)",
      "Bash(docker ps*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl top*)",
      "Bash(helm template*)",
      "Bash(helm lint*)",
      "Bash(helm list*)",
      "Bash(tflint*)",
      "Bash(checkov*)",
      "Bash(trivy*)",
      "Bash(hadolint*)",
      "Bash(terraform-docs*)"
    ],
    "deny": [
      "Bash(terraform destroy *)",
      "Bash(terraform apply -auto-approve *)",
      "Bash(aws iam delete* *)",
      "Bash(aws iam remove* *)",
      "Bash(aws ec2 terminate-instances *)",
      "Bash(aws ec2 delete* *)",
      "Bash(aws ec2 revoke* *)",
      "Bash(aws rds delete* *)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3api delete-bucket *)",
      "Bash(aws dynamodb delete-table *)",
      "Bash(aws lambda delete-function *)",
      "Bash(aws cognito-idp delete-user-pool *)",
      "Bash(aws opensearchserverless delete-collection *)",
      "Bash(aws cloudtrail delete-trail *)",
      "Bash(aws kms schedule-key-deletion *)",
      "Bash(aws kms disable-key *)",
      "Bash(ansible *)",
      "Bash(ansible-vault decrypt *)",
      "Bash(ansible-vault view*)",
      "Bash(ansible-lint --fix*)",
      "Bash(ansible-lint --write*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(python3 -c 'import json,sys;print(json.load(sys.stdin).get(\"tool_input\",{}).get(\"file_path\",\"\"))' 2>/dev/null); case \"$f\" in *.tf|*.tfvars) ;; *) exit 0;; esac; [ -f \"$f\" ] || exit 0; command -v terraform >/dev/null 2>&1 || exit 0; terraform fmt \"$f\" >/dev/null 2>&1; exit 0"
          },
          {
            "type": "command",
            "command": "f=$(python3 -c 'import json,sys;print(json.load(sys.stdin).get(\"tool_input\",{}).get(\"file_path\",\"\"))' 2>/dev/null); case \"$f\" in *.yml|*.yaml) ;; *) exit 0;; esac; b=${f##*/}; case \"$b\" in vault|vault.yml|vault.yaml|vault_*|*-vault.yml|*-vault.yaml) exit 0;; esac; case \"$f\" in */.github/*|*/knowledge/templates/*|*/molecule/*) exit 0;; esac; case \"$f\" in */ansible/*|*/roles/*|*/playbooks/*|*/group_vars/*|*/host_vars/*|*/site.yml|*/site.yaml) ;; *) exit 0;; esac; [ -f \"$f\" ] || exit 0; [ -f .ansible-lint ] && [ -f .yamllint ] || exit 0; rc=0; o1=\"\"; o2=\"\"; command -v yamllint >/dev/null 2>&1 && o1=$(yamllint -f parsable \"$f\" 2>&1); command -v ansible-lint >/dev/null 2>&1 && { o2=$(ansible-lint --nocolor -q \"$f\" 2>&1) || rc=1; }; [ \"$rc\" -eq 0 ] && exit 0; { printf 'ansible-lint findings for %s (fix these, then re-save). yamllint output is advisory:\\n' \"$f\"; printf '%s\\n%s\\n' \"$o2\" \"$o1\" | sed '/^$/d' | head -30; } >&2; exit 2"
          }
        ]
      }
    ]
  }
}
